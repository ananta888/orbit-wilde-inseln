{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ananta888.github.io/orbit-wilde-inseln/schemas/v1/objectives.schema.json",
  "title": "Orbit objectives v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "objectives": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "event": {
            "enum": [
              "observe",
              "collect",
              "use",
              "speak",
              "reach",
              "hit",
              "distract",
              "sneak"
            ]
          },
          "target": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
          },
          "count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "requires_items": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
            },
            "maxItems": 8,
            "uniqueItems": true
          },
          "consumes_items": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
            },
            "maxItems": 8,
            "uniqueItems": true
          },
          "learning_goals": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
            },
            "maxItems": 16,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "description",
          "event",
          "target",
          "count",
          "requires_items",
          "consumes_items",
          "learning_goals"
        ],
        "additionalProperties": false
      },
      "maxItems": 64,
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "objectives"
  ],
  "additionalProperties": false
}
