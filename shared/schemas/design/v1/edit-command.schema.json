{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ananta888.github.io/orbit-wilde-inseln/shared/schemas/design/v1/edit-command.schema.json",
  "type": "object",
  "properties": {
    "radial": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{1,64}$"
    },
    "time": {
      "type": "number",
      "minimum": 0,
      "maximum": 60
    },
    "strength": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "paint_tool": {
      "enum": [
        "brush",
        "airbrush",
        "spray",
        "fill",
        "gradient",
        "eraser",
        "smudge",
        "stamp"
      ]
    },
    "duration": {
      "type": "number",
      "minimum": 0.1,
      "maximum": 60
    },
    "normal": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": -100,
        "maximum": 100
      },
      "minItems": 3,
      "maxItems": 3
    },
    "channel": {
      "enum": [
        "color",
        "roughness",
        "metallic",
        "emission",
        "opacity"
      ]
    },
    "tool": {
      "enum": [
        "add",
        "bend",
        "clay",
        "clip",
        "collider",
        "crease",
        "cut",
        "deflate",
        "delete",
        "flatten",
        "grab",
        "inflate",
        "lock",
        "mask",
        "material",
        "mount",
        "move",
        "paint",
        "pinch",
        "pose",
        "pull",
        "push",
        "refine",
        "rename",
        "rig",
        "scale",
        "simplify",
        "smooth",
        "stretch",
        "subtract",
        "twist",
        "union"
      ]
    },
    "samples": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "number",
          "minimum": -100,
          "maximum": 100
        },
        "minItems": 3,
        "maxItems": 3
      },
      "maxItems": 64,
      "minItems": 1
    },
    "name": {
      "type": "string",
      "maxLength": 100
    },
    "color": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": -100,
        "maximum": 100
      },
      "minItems": 3,
      "maxItems": 3
    },
    "points": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "number",
          "minimum": -100,
          "maximum": 100
        },
        "minItems": 3,
        "maxItems": 3
      },
      "maxItems": 48,
      "minItems": 2
    },
    "axis": {
      "enum": [
        0,
        1,
        2
      ]
    },
    "regions": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9_-]{1,64}$"
      },
      "maxItems": 96,
      "minItems": 0,
      "uniqueItems": true
    },
    "rotation": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": -100,
        "maximum": 100
      },
      "minItems": 3,
      "maxItems": 3
    },
    "material": {
      "type": "object",
      "properties": {
        "roughness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "metallic": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "emissive": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": -100,
            "maximum": 100
          },
          "minItems": 3,
          "maxItems": 3
        },
        "detail": {
          "enum": [
            "none",
            "skin",
            "scales",
            "fur",
            "feather",
            "horn",
            "bone",
            "metal",
            "stone",
            "crystal",
            "slime"
          ]
        },
        "detail_scale": {
          "type": "number",
          "minimum": 1,
          "maximum": 100
        }
      },
      "additionalProperties": false
    },
    "tolerance": {
      "type": "number",
      "minimum": 0.0001,
      "maximum": 0.1
    },
    "delta": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": -100,
        "maximum": 100
      },
      "minItems": 3,
      "maxItems": 3
    },
    "value": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "number",
          "minimum": 0,
          "maximum": 3
        }
      ]
    },
    "kind": {
      "type": "string",
      "maxLength": 32
    },
    "loop": {
      "type": "boolean"
    },
    "bone": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{1,64}$"
    },
    "target": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{1,64}$"
    },
    "angle": {
      "type": "number",
      "minimum": -3.141592653589793,
      "maximum": 3.141592653589793
    },
    "radius": {
      "type": "number",
      "minimum": 0.005,
      "maximum": 5
    },
    "size": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": -100,
        "maximum": 100
      },
      "minItems": 3,
      "maxItems": 3
    },
    "keys": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "bone": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,64}$"
          },
          "time": {
            "type": "number",
            "minimum": 0,
            "maximum": 60
          },
          "rotation": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": -100,
              "maximum": 100
            },
            "minItems": 3,
            "maxItems": 3
          }
        },
        "required": [
          "bone",
          "time",
          "rotation"
        ],
        "additionalProperties": false
      },
      "maxItems": 512,
      "minItems": 1
    },
    "position": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": -100,
        "maximum": 100
      },
      "minItems": 3,
      "maxItems": 3
    },
    "symmetry": {
      "enum": [
        "",
        "x",
        "y",
        "z",
        "xy",
        "xz",
        "yz",
        "xyz"
      ]
    }
  },
  "required": [
    "tool"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "tool": {
            "enum": [
              "push",
              "pull",
              "grab",
              "inflate",
              "deflate",
              "smooth",
              "flatten",
              "pinch",
              "crease",
              "clay",
              "stretch",
              "bend",
              "twist",
              "scale",
              "move",
              "paint",
              "mask"
            ]
          }
        }
      },
      "then": {
        "required": [
          "samples"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "tool": {
            "enum": [
              "add",
              "collider"
            ]
          }
        }
      },
      "then": {
        "required": [
          "id"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "tool": {
            "enum": [
              "pose"
            ]
          }
        }
      },
      "then": {
        "required": [
          "bone"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "tool": {
            "enum": [
              "pose"
            ]
          }
        }
      },
      "then": {
        "required": [
          "rotation"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "tool": {
            "enum": [
              "rename"
            ]
          }
        }
      },
      "then": {
        "required": [
          "name"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "tool": {
            "enum": [
              "clip"
            ]
          }
        }
      },
      "then": {
        "required": [
          "keys"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "tool": {
            "enum": [
              "mount",
              "collider"
            ]
          }
        }
      },
      "then": {
        "required": [
          "position"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "tool": {
            "enum": [
              "material"
            ]
          }
        }
      },
      "then": {
        "required": [
          "material"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "tool": {
            "enum": [
              "lock"
            ]
          }
        }
      },
      "then": {
        "required": [
          "value"
        ]
      }
    }
  ]
}
