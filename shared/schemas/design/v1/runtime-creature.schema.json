{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ananta888.github.io/orbit-wilde-inseln/shared/schemas/design/v1/runtime-creature.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "asset_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{1,64}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "source_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "behavior": {
      "oneOf": [
        {
          "const": {
            "locomotion": "dragon",
            "mountable": true
          }
        },
        {
          "const": {
            "locomotion": "stationary",
            "mountable": false
          }
        }
      ]
    },
    "document": {
      "$ref": "edit-document.schema.json"
    },
    "report": {
      "type": "object",
      "properties": {
        "triangles": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        },
        "vertices": {
          "type": "integer",
          "minimum": 3,
          "maximum": 100000
        }
      },
      "required": [
        "triangles",
        "vertices"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "asset_id",
    "revision",
    "source_hash",
    "behavior",
    "document",
    "report"
  ],
  "additionalProperties": false
}
