# Export these variables in your shell; this file is documentation, not auto-loaded.
ORBIT_HOST=127.0.0.1
ORBIT_PORT=8443
ORBIT_DATA_DIR=.local
# TLS for Quest LAN access: pass --host 0.0.0.0 --cert ... --key ...
# Leave unset for deterministic local character dialogue without AI services.
ORBIT_ANANTA_URL=
ORBIT_ANANTA_TOKEN_FILE=
# Optional direct providers. Whisper direct input is PCM WAV only; browser WebM needs the Ananta bridge.
ORBIT_WHISPER_URL=
ORBIT_WHISPER_CPU_URL=
ORBIT_PIPER_URL=
