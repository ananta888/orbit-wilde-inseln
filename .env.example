# Export these variables in your shell; this file is documentation, not auto-loaded.
ORBIT_HOST=127.0.0.1
ORBIT_PORT=8443
ORBIT_DATA_DIR=.local
# TLS for Quest LAN access: pass --host 0.0.0.0 --cert ... --key ...
# Leave unset for deterministic local character dialogue without AI services.
ORBIT_ANANTA_URL=
ORBIT_ANANTA_TOKEN_FILE=
# Optional direct providers. Whisper direct input is PCM WAV only; browser WebM needs the Ananta bridge.
ORBIT_WHISPER_URL=
ORBIT_WHISPER_CPU_URL=
ORBIT_PIPER_URL=
# Optional structured creature-design planner (Ananta adapter or another local service).
# POST schema/context/instruction -> {"speech": "...", "operations": [...]}.
# Without it the editor labels its limited deterministic command parser explicitly.
ORBIT_DESIGN_AI_URL=
ORBIT_DESIGN_AI_TOKEN=
ORBIT_DESIGN_AI_TOKEN_FILE=
# Optional absolute Node executable when it is not on PATH (meshoptimizer).
ORBIT_NODE=
# tools/run-local.py can load these variables from ignored .local/runtime.json.
